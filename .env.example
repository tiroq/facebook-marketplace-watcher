# PostgreSQL
POSTGRES_DB=fbwatcher
POSTGRES_USER=fbwatcher
POSTGRES_PASSWORD=fbwatcher_secret
DATABASE_URL=postgres://fbwatcher:fbwatcher_secret@postgres:5432/fbwatcher?sslmode=disable

# NATS
NATS_URL=nats://nats:4222

# Catalog API
HTTP_ADDR=:8080

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_DRY_RUN=false
DEFAULT_SEARCH_QUERY=laptop
DEFAULT_LOCATION_HINT=Bangkok
DEFAULT_INTERVAL_MINUTES=40
DEFAULT_JITTER_MINUTES=10
DEFAULT_SKIP_PROBABILITY=0.5
DEFAULT_MAX_CARDS=50
DEFAULT_MAX_SCROLLS=5
DEFAULT_TIMEZONE=Asia/Bangkok

# Grabber
FB_BROWSER_PROFILE_DIR=/browser-profile
FB_HEADLESS=false
FB_SEARCH_BASE_URL=https://www.facebook.com/marketplace/search/?query=
MAX_CARDS_PER_RUN=50
MAX_SCROLLS_PER_RUN=5
